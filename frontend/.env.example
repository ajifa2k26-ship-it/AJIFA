# Adresse publique du site (votre nom de domaine) — sans "/" final
NEXT_PUBLIC_SITE_URL=https://ajifa.sn

# Adresse de l'API hébergée sur Render
NEXT_PUBLIC_API_URL=https://ajifa-api.onrender.com

# Même valeur que REVALIDATE_SECRET sur Render (mise à jour instantanée du site)
REVALIDATE_SECRET=

# Code de vérification Google Search Console (balise meta, valeur "content" uniquement) — optionnel
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
