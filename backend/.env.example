# --- Base de données (MongoDB Atlas, offre gratuite M0) ---
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/ajifa?retryWrites=true&w=majority

# --- Sécurité ---
# Chaîne aléatoire longue (ex : générée avec `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=changez-moi
JWT_EXPIRES_IN=7d

# Compte administratrice créé au premier démarrage (changez le mot de passe ensuite depuis l'admin)
ADMIN_EMAIL=admin@ajifa.sn
ADMIN_PASSWORD=changez-moi-aussi
ADMIN_NAME=Administratrice

# --- CORS : domaines du site autorisés à appeler l'API (séparés par des virgules) ---
CORS_ORIGINS=http://localhost:3000,https://ajifa.sn,https://www.ajifa.sn
CORS_ALLOW_VERCEL_PREVIEWS=false

# --- Images (Cloudinary, offre gratuite) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ajifa

# --- Mise à jour instantanée du site après une modification dans l'admin ---
FRONTEND_REVALIDATE_URL=https://ajifa.sn/api/revalidate
REVALIDATE_SECRET=meme-valeur-que-sur-vercel

PORT=4000
